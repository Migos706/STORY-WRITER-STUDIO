{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Story Studio platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "author", "user"] },
        "authorStatus": { "type": "string", "enum": ["none", "pending", "approved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "authorStatus"]
    },
    "Story": {
      "title": "Story",
      "description": "A story created by an author.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "genre": { "type": "string" },
        "mood": { "type": "string" },
        "imageUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected"] },
        "safetyStatus": { "type": "string", "enum": ["unchecked", "safe", "flagged"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "title", "content", "status", "safetyStatus"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and roles."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Stores stories created by authors."
    },
    "/users/{userId}/savedStories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Stories saved by the user for later reading."
    }
  }
}
