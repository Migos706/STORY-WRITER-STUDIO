rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "migosking706@gmail.com" && request.auth.token.email_verified == true) ||
         request.auth.token.email == "admin@storystudio.app");
    }

    function isAuthor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'author';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'authorStatus']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'author', 'user'] &&
             data.authorStatus in ['none', 'pending', 'approved'];
    }

    function isValidStory(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'title', 'status', 'safetyStatus']) &&
             data.authorId is string &&
             data.authorName is string &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['draft', 'pending', 'approved', 'rejected'] &&
             data.safetyStatus in ['unchecked', 'safe', 'flagged'];
    }

    function isValidChapter(data) {
      return data.keys().hasAll(['id', 'storyId', 'title', 'content', 'order']) &&
             data.id is string &&
             data.storyId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 100000 &&
             data.order is int;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'text']) &&
             data.id is string &&
             data.userId is string &&
             data.userName is string &&
             data.text is string && data.text.size() <= 2000;
    }

    function isValidCharacter(data) {
      return data.keys().hasAll(['id', 'userId', 'name']) &&
             data.id is string &&
             data.userId is string &&
             data.name is string && data.name.size() <= 200;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'isRead']) &&
             data.id is string &&
             data.title is string &&
             data.message is string &&
             data.type is string &&
             data.isRead is bool;
    }

    function isValidRating(data) {
      return data.keys().hasAll(['userId', 'rating']) &&
             data.userId is string &&
             data.rating is int &&
             data.rating >= 1 &&
             data.rating <= 5;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId is string;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['storyId', 'title']) &&
             data.storyId is string &&
             data.title is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      allow create: if isAuthenticated() && 
                    isOwner(userId) && 
                    isValidUser(incoming()) && 
                    incoming().uid == userId &&
                    ((incoming().role == 'user' && incoming().authorStatus == 'none') || isAdmin());
                    
      allow update: if isAuthenticated() && 
                    (
                      isAdmin() || 
                      (isOwner(userId) && 
                       isValidUser(incoming()) &&
                       incoming().uid == userId &&
                       incoming().role == existing().role && // Users cannot change their own role
                       (incoming().authorStatus == existing().authorStatus || (incoming().authorStatus == 'pending' && existing().authorStatus == 'none'))
                      )
                    );
                    
      match /notifications/{notificationId} {
        allow read, update, delete: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isValidNotification(incoming());
      }

      match /readingProgress/{storyId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      match /characters/{characterId} {
        allow read, write: if isAuthenticated() && isOwner(userId) && isValidCharacter(incoming());
      }

      match /savedStories/{storyId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      match /history/{storyId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    match /stories/{storyId} {
      // Anyone can read approved stories. Admins and the author can read any status.
      allow read: if resource.data.status == 'approved' || 
                  (isAuthenticated() && (isAdmin() || resource.data.authorId == request.auth.uid));
      
      // Only authors and admins can create stories
      allow create: if isAuthenticated() && 
                    (isAuthor() || isAdmin()) &&
                    isValidStory(incoming()) &&
                    incoming().authorId == request.auth.uid;
                    
      // Authors can update their own stories, admins can update any story
      allow update: if isAuthenticated() && 
                    isValidStory(incoming()) &&
                    incoming().authorId == existing().authorId && // Cannot change author
                    (
                      isAdmin() || 
                      (isOwner(existing().authorId) && isAuthor())
                    );
                    
      allow delete: if isAuthenticated() && (isAdmin() || isOwner(resource.data.authorId));

      match /chapters/{chapterId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() &&
                                      (isAdmin() || 
                                       (get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid && isAuthor()));
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
                      isValidComment(incoming()) &&
                      incoming().userId == request.auth.uid;
                      
        allow update: if isAuthenticated() && 
                      (
                        isAdmin() ||
                        (incoming().userId == existing().userId && 
                         (
                           // Standard edit: only modify the text
                           incoming().diff(existing()).affectedKeys().hasOnly(['text']) ||
                           // Reporting/Flagging system updates
                           incoming().diff(existing()).affectedKeys().hasAny(['reportCount', 'isReported', 'reportedBy'])
                         )
                        )
                      );
                      
        allow delete: if isAuthenticated() && (
                        isAdmin() || 
                        existing().userId == request.auth.uid ||
                        get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
                      );
      }

      match /ratings/{userId} {
        allow read: if true;
        allow create, update: if isAuthenticated() &&
                              isOwner(userId) &&
                              isValidRating(incoming()) &&
                              incoming().userId == request.auth.uid;
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      match /likes/{userId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                          isOwner(userId) &&
                          isValidLike(incoming()) &&
                          incoming().userId == request.auth.uid;
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }
  }
}
